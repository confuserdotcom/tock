{
  "manifest_version": 3,
  "name": "tock",
  "version": "1.0",
  "description": "Tells tock's trackd, on this computer only, the address of the tab in front. Nothing goes over the network.",
  "key": "",
  "permissions": ["tabs", "nativeMessaging"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "incognito": "spanning",
  "browser_specific_settings": { "gecko": { "id": "browser@tock.local", "strict_min_version": "115.0" } }
}
